<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="igvc_hardware" type="system">
    <hardware>
      <plugin>igvc_control/IgvcHardware</plugin>
      <param name="serial_port">$(arg serial_port)</param>
      <param name="gear_ratio">12.75</param>
      <param name="max_motor_rpm">3000</param>
      <param name="left_motor_inverted">false</param>
      <param name="right_motor_inverted">false</param>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

</robot>
