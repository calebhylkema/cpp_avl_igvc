<?xml version="1.0"?>
<!--
  IGVC Robot URDF — AVL IGVC 2026

  All sensor positions measured relative to IMU (XSENS), which is base_link origin.
  Source measurements were in inches with Y-right-positive; converted to meters
  in ROS REP 103 convention (X-forward, Y-left, Z-up).

  Sensors (meters, relative to IMU):
    imu_link        :  0.0000,  0.0000,  0.0000   (origin)
    lidar_link      :  0.0889,  0.0000,  0.1588
    left_zedx_link  :  0.0984,  0.2858,  0.0572
    right_zedx_link :  0.0984, -0.2858,  0.0572
    front_zedx_link :  0.6795,  0.0000, -0.1080

  Chassis (two boxes, dims in inches → meters):
    Main box:  29.25 × 26.75 × 14.75  (0.7430 × 0.6795 × 0.3747)
    Top box:   23.00 × 22.50 ×  5.75  (0.5842 × 0.5715 × 0.1461)
    Top box front is 11" from main box front, overhangs 4.75" at rear
    Top box centered on main box width-wise (2" gap each side)

  Drive sprockets: 19.25" below IMU, 7" forward of IMU
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igvc">

  <xacro:arg name="serial_port" default="/dev/ttyACM0" />

  <!-- Drivetrain (must match controllers.yaml) -->
  <xacro:property name="wheel_separation" value="0.730" />
  <xacro:property name="wheel_radius"     value="0.0762" />

  <!-- IMU height above ground (21.5 in) -->
  <xacro:property name="imu_height" value="0.5556" />

  <!-- Drive sprocket position relative to IMU -->
  <xacro:property name="sprocket_x" value="0.1778" />
  <xacro:property name="sprocket_z" value="-0.4890" />

  <!-- Main box: 29.25 × 26.75 × 14.75 in -->
  <xacro:property name="main_length" value="0.7430" />
  <xacro:property name="main_width"  value="0.6795" />
  <xacro:property name="main_height" value="0.3747" />

  <!-- Top box: 23 × 22.5 × 5.75 in -->
  <xacro:property name="top_length" value="0.5842" />
  <xacro:property name="top_width"  value="0.5715" />
  <xacro:property name="top_height" value="0.1461" />

  <!-- Tread enclosures: 32.5 × 3.5 × 5.5 in, 0.75 in inside main box edges -->
  <xacro:property name="tread_length" value="0.8255" />
  <xacro:property name="tread_width"  value="0.0889" />
  <xacro:property name="tread_height" value="0.1397" />
  <xacro:property name="tread_y"      value="0.3653" />

  <!--
    Box positions relative to IMU (X-forward):
      Main box front  = 27.00 in = 0.6858 m   (front ZEDX at 26.75 is on it)
      Main box back   = -2.25 in = -0.0572 m
      Main box center X = 12.375 in = 0.3143 m

      Top box front   = 16.00 in = 0.4064 m   (11 in behind main front)
      Top box back    = -7.00 in = -0.1778 m   (overhangs 4.75 in)
      Top box center X = 4.50 in = 0.1143 m

      Top box sits on main box:
        Top of main box  = top of top box - top_height = -5.75 in = -0.1461 m
        Main box center Z = -0.1461 - main_height/2 = -13.125 in = -0.3334 m
        Top box center Z  = -top_height/2 = -2.875 in = -0.0730 m
  -->

  <!-- ================= Base ================= -->

  <link name="base_footprint" />

  <link name="base_link">
    <!-- Main chassis box (shifted up so treads fit beneath) -->
    <visual>
      <origin xyz="0.3143 0 -0.2191" rpy="0 0 0" />
      <geometry>
        <box size="${main_length} ${main_width} ${main_height}" />
      </geometry>
      <material name="grey"><color rgba="0.55 0.55 0.55 0.8" /></material>
    </visual>
    <!-- Top sensor platform -->
    <visual>
      <origin xyz="0.1143 0 0.0413" rpy="0 0 0" />
      <geometry>
        <box size="${top_length} ${top_width} ${top_height}" />
      </geometry>
      <material name="light_grey"><color rgba="0.70 0.70 0.70 0.8" /></material>
    </visual>
    <!-- Left tread enclosure -->
    <visual>
      <origin xyz="0.3143 ${tread_y} -0.4763" rpy="0 0 0" />
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}" />
      </geometry>
      <material name="dark_grey"><color rgba="0.25 0.25 0.25 0.9" /></material>
    </visual>
    <!-- Right tread enclosure -->
    <visual>
      <origin xyz="0.3143 ${-tread_y} -0.4763" rpy="0 0 0" />
      <geometry>
        <box size="${tread_length} ${tread_width} ${tread_height}" />
      </geometry>
      <material name="dark_grey"><color rgba="0.25 0.25 0.25 0.9" /></material>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child  link="base_link" />
    <origin xyz="0 0 ${imu_height}" rpy="0 0 0" />
  </joint>

  <!-- ================= Drive Sprockets ================= -->

  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="${wheel_radius}" length="0.05" /></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child  link="left_wheel" />
    <origin xyz="${sprocket_x} ${wheel_separation/2} ${sprocket_z}" rpy="${-pi/2} 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="${wheel_radius}" length="0.05" /></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child  link="right_wheel" />
    <origin xyz="${sprocket_x} ${-wheel_separation/2} ${sprocket_z}" rpy="${-pi/2} 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ================= IMU (XSENS) ================= -->

  <link name="imu_link">
    <visual>
      <geometry><box size="0.06 0.06 0.025" /></geometry>
      <material name="white"><color rgba="0.95 0.95 0.95 1" /></material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child  link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ================= LIDAR ================= -->
  <!-- (3.5, 0, 6.25) in → (0.0889, 0, 0.1588) m -->

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.05" /></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1" /></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child  link="lidar_link" />
    <origin xyz="0.0889 0 0.1588" rpy="0 0 0" />
  </joint>

  <!-- ================= Left ZED X (red) ================= -->
  <!-- (3.875, -11.25, 2.25) in → (0.0984, 0.2858, 0.0572) m  [Y negated for ROS] -->

  <link name="left_zedx_link">
    <visual>
      <geometry><box size="0.025 0.065 0.038" /></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1" /></material>
    </visual>
  </link>
  <joint name="left_zedx_joint" type="fixed">
    <parent link="base_link" />
    <child  link="left_zedx_link" />
    <origin xyz="0.0984 0.2858 0.0572" rpy="0 0 ${pi/2}" />
  </joint>

  <link name="left_zedx_optical" />
  <joint name="left_zedx_optical_joint" type="fixed">
    <parent link="left_zedx_link" />
    <child  link="left_zedx_optical" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ================= Right ZED X (yellow) ================= -->
  <!-- (3.875, 11.25, 2.25) in → (0.0984, -0.2858, 0.0572) m  [Y negated for ROS] -->

  <link name="right_zedx_link">
    <visual>
      <geometry><box size="0.025 0.065 0.038" /></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1" /></material>
    </visual>
  </link>
  <joint name="right_zedx_joint" type="fixed">
    <parent link="base_link" />
    <child  link="right_zedx_link" />
    <origin xyz="0.0984 -0.2858 0.0572" rpy="0 0 ${-pi/2}" />
  </joint>

  <link name="right_zedx_optical" />
  <joint name="right_zedx_optical_joint" type="fixed">
    <parent link="right_zedx_link" />
    <child  link="right_zedx_optical" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ================= Front ZED X (green) ================= -->
  <!-- (26.75, 0, -4.25) in → (0.6795, 0, -0.1080) m -->

  <link name="front_zedx_link">
    <visual>
      <geometry><box size="0.065 0.025 0.038" /></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1" /></material>
    </visual>
  </link>
  <joint name="front_zedx_joint" type="fixed">
    <parent link="base_link" />
    <child  link="front_zedx_link" />
    <origin xyz="0.6795 0 -0.1080" rpy="0 0 0" />
  </joint>

  <link name="front_zedx_optical" />
  <joint name="front_zedx_optical_joint" type="fixed">
    <parent link="front_zedx_link" />
    <child  link="front_zedx_optical" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ================= ros2_control ================= -->
  <xacro:include filename="$(find igvc_description)/urdf/ros2_control.urdf.xacro" />

</robot>
